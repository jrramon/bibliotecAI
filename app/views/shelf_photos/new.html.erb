<section class="page shelf-photo-new">
  <header class="page-head">
    <div class="title-group">
      <h1 class="page-title"><span class="accent">Estanterías</span></h1>
      <p class="sub">Sube una o varias fotos de tus libros. Claude las irá identificando una a una en segundo plano.</p>
    </div>
  </header>

  <div class="card">
    <%= form_with url: library_shelf_photos_path(@library), method: :post,
                  multipart: true, html: {class: "shelf-photo-upload", data: {controller: "shelf-upload"}} do %>
      <div class="form-inputs">
        <label class="field">
          <span class="field-label">Imágenes de la estantería</span>
          <%= file_field_tag "shelf_photo[images][]",
                             multiple: true,
                             accept: "image/jpeg,image/png,image/webp,image/heic",
                             required: true,
                             data: {shelf_upload_target: "input", action: "change->shelf-upload#validate"} %>
          <small>JPEG, PNG, WebP o HEIC. Puedes seleccionar varias a la vez. Máximo 10 MB por foto, 100 MB en total.</small>
          <small class="upload-status" data-shelf-upload-target="status" hidden></small>
        </label>
      </div>

      <div class="form-actions">
        <%= submit_tag "Subir e identificar", class: "btn btn-primary", data: {shelf_upload_target: "submit"} %>
        <%= link_to "Cancelar", library_path(@library), class: "btn btn-ghost" %>
      </div>
    <% end %>
  </div>

  <% shelf_photos = @library.shelf_photos.recent %>
  <% if shelf_photos.any? %>
    <section class="shelf-photos-section">
      <h2 class="section-title">Fotos subidas <span class="count">(<%= shelf_photos.size %>)</span></h2>
      <ul class="shelf-photo-strip">
        <% shelf_photos.each do |photo| %>
          <li>
            <%= link_to [@library, photo], class: "shelf-photo-thumb status-#{photo.status}" do %>
              <%= image_tag photo.image.variant(:card), alt: "Foto de estantería subida por #{photo.uploaded_by_user.email}" %>
              <span class="badge status-<%= photo.status %>"><%= photo.status.humanize %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= link_to "← Volver a #{@library.name}", library_path(@library), class: "back-link" %>
</section>
