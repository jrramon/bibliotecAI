# Rails
RAILS_ENV=production
RAILS_MASTER_KEY=your_master_key_here
SECRET_KEY_BASE=your_secret_key_base_here

# Public hostname(s) this deployment serves. Comma-separated if more than
# one (apex + www, several subdomains). The first one is treated as the
# canonical and used for mailer links + SMTP HELO. REQUIRED — Rails will
# fail to boot in production without it.
APP_HOSTS=biblio.example.org

# Database (PostgreSQL on host machine)
DATABASE_HOST=host.docker.internal
DATABASE_USERNAME=bibliotecai
BIBLIOTECAI_DATABASE_PASSWORD=your_database_password_here

# Email (Brevo SMTP)
BREVO_USERNAME=your_brevo_username
BREVO_PASSWORD=your_brevo_password

# Background jobs (SolidQueue runs inside Puma)
SOLID_QUEUE_IN_PUMA=1

# Telegram bot (optional). Without these, the bot endpoints reject
# every request and the rest of the app keeps working.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Anthropic API key (format sk-ant-…). The `claude` CLI picks this up
# from the environment and uses it instead of the interactive
# subscription auth — required in production because the VPS has no
# browser login. Get one at https://console.anthropic.com → API Keys.
# WARNING: this switches billing from your subscription to per-token
# usage on this key. Keep MONTHLY_CLAUDE_BUDGET set as a circuit
# breaker (see below).
ANTHROPIC_API_KEY=

# Where the host claude CLI reaches the MCP HTTP endpoint. The
# claude-worker container is on the same Docker network as `web`, so
# the service-name URL works without going through the public proxy.
MCP_ENDPOINT_URL=http://web/mcp

# LLM provider switch. "claude_cli" (default) uses the claude binary +
# ANTHROPIC_API_KEY above; "nan_api" calls an OpenAI-compatible HTTP API
# (NaN.builders) so a task can run against non-Claude models. Per-task
# overrides win over the global. A task on nan_api runs in-process (net/http)
# and does NOT need the mounted claude binary.
LLM_PROVIDER=claude_cli
# LLM_PROVIDER_SHELF=nan_api
# LLM_PROVIDER_COVER=nan_api
# LLM_PROVIDER_CLASSIFY=nan_api
# LLM_PROVIDER_TELEGRAM=nan_api
# LLM_MODEL_SHELF=qwen3.6
# LLM_MODEL_COVER=qwen3.6
# LLM_MODEL_CLASSIFY=deepseek-v4-flash
# LLM_MODEL_TELEGRAM=deepseek-v4-flash
# NaN.builders API (only when a task uses nan_api). Key format sk-…
NAN_API_KEY=
NAN_BASE_URL=https://api.nan.builders/v1

# Langfuse — LLM tracing, prompt management and evals (optional). Without the
# keys, tracing is a silent no-op. Get them at cloud.langfuse.com.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Tags every trace; defaults to Rails.env (production here). Override only if
# you run several deployments against the same Langfuse project.
# LANGFUSE_TRACING_ENVIRONMENT=production

# Optional
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5

# Circuit breaker on rolling-30-day Claude spend, in USD. When the sum of
# ShelfPhoto + CoverPhoto + TelegramMessage cost crosses this limit, the
# three Claude-calling jobs short-circuit and reply with a "presupuesto
# agotado" message instead of making more API calls. Leave unset to
# disable the cap entirely.
MONTHLY_CLAUDE_BUDGET=
