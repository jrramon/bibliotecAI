# Copy to .env (docker-compose loads it automatically) and adjust.
# This file documents environment variables used in development.

DATABASE_USERNAME=rails_dev
DATABASE_PASSWORD=aqwe123
DATABASE_HOST=db
DATABASE_PORT=5432

# Path to the Claude Code CLI binary on the HOST running the Solid Queue worker.
# Leave as "claude" if it's on $PATH, otherwise set absolute path.
# Example on macOS cmux install: /Applications/cmux.app/Contents/Resources/bin/claude
CLAUDE_BIN=claude

# LLM provider switch. "claude_cli" (default) shells out to the claude binary
# above; "nan_api" calls an OpenAI-compatible HTTP API (NaN.builders) so you
# can run against non-Claude models. Per-task overrides win over the global.
LLM_PROVIDER=claude_cli
# LLM_PROVIDER_SHELF=nan_api     # estantería
# LLM_PROVIDER_COVER=nan_api     # portada
# LLM_PROVIDER_CLASSIFY=nan_api  # clasificador
# LLM_PROVIDER_TELEGRAM=nan_api  # agente Telegram
# Model id per task (e.g. qwen3.6 for vision, deepseek-v4-flash for tools).
# LLM_MODEL_SHELF=qwen3.6
# LLM_MODEL_COVER=qwen3.6
# LLM_MODEL_CLASSIFY=deepseek-v4-flash
# LLM_MODEL_TELEGRAM=deepseek-v4-flash
# NaN.builders API (only needed when a task uses nan_api). Key format sk-…
NAN_API_KEY=
NAN_BASE_URL=https://api.nan.builders/v1
# Per-model token prices (USD per 1M tokens) so nan_api spend gets a cost and
# counts toward MONTHLY_CLAUDE_BUDGET / shows in Langfuse. Empty = nan_api
# counts as $0. JSON object keyed by model id:
# LLM_PRICES={"qwen3.6":{"input":0.30,"output":0.90},"mimo-v2.5":{"input":0.15,"output":0.60}}

# Google Books API key (optional). Without it, requests share the public
# per-IP quota (~1000/day) and return 429 once exhausted. With a key the
# default quota is much higher (free tier).
# Create at https://console.cloud.google.com/apis/credentials after enabling
# the "Books API" in your project.
GOOGLE_BOOKS_API_KEY=

# Telegram bot — see docs/telegram-bot.md for setup.
# Get TELEGRAM_BOT_TOKEN and TELEGRAM_BOT_USERNAME from @BotFather on Telegram.
# Generate TELEGRAM_WEBHOOK_SECRET locally:
#   ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Langfuse — LLM tracing, prompt management and evals (optional). Without the
# keys, tracing is a silent no-op and the app behaves exactly as before.
# Get the keys at cloud.langfuse.com → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Tags every trace so dev/prod traffic stays separable in one project.
# Defaults to Rails.env — uncomment only to override.
# LANGFUSE_TRACING_ENVIRONMENT=development
